# Copy to .env.local for local development. Names only — never commit real values.

# ── Browser-safe (VITE_ prefix means: shipped to the browser) ─────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Server-only (Netlify: set scope = Functions/Runtime; NEVER prefix with VITE_) ─
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SITE_URL=
